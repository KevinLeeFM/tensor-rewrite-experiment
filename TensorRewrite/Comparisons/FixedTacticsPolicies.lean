    TensorRewrite.Theory.LogicalFamily.Rule.rhs,
    TensorRewrite.Theory.LogicalFamily.Rule.Condition,
    TensorRewrite.Theory.LogicalFamily.allRules])

/-- Function extensionality followed by the same uniform simplification policy. -/
macro "fixed_funext_simp" : tactic =>
  `(tactic| (
    repeat (first | funext index | intro)
    fixed_simp))

