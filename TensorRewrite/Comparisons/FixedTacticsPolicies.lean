module

public import TensorRewrite.Comparisons.FixedTacticsStatements

/-! Fixed, uniformly defined tactic policies. The full unfolding lists count as custom automation. -/

public meta section

/-- Uniform simplification over semantic definitions, without experiment rewrite lemmas. -/
macro "fixed_simp" : tactic =>
  `(tactic| simp_all [
    TensorRewrite.Pilot.Tensor.constant,
    TensorRewrite.Pilot.Tensor.map,
    TensorRewrite.Pilot.Tensor.map₂,
    TensorRewrite.Pilot.Tensor.reindex,
    TensorRewrite.Pilot.Tensor.reverseIndex,
    TensorRewrite.Pilot.Tensor.reverse,
    TensorRewrite.Pilot.Tensor.axisMask,
    TensorRewrite.Pilot.Contraction.appendShape,
    TensorRewrite.Pilot.Contraction.appendIndex,
    TensorRewrite.Pilot.Contraction.firstIndex,
    TensorRewrite.Pilot.Contraction.secondIndex,
    TensorRewrite.Pilot.Contraction.Plan.outputShape,
    TensorRewrite.Pilot.Contraction.Plan.lhsShape,
    TensorRewrite.Pilot.Contraction.Plan.rhsShape,
    TensorRewrite.Pilot.Contraction.Plan.lhsIndex,
    TensorRewrite.Pilot.Contraction.Plan.rhsIndex,
    TensorRewrite.Pilot.Contraction.terms,
    TensorRewrite.Pilot.Contraction.dotTensor,
    TensorRewrite.Pilot.Contraction.outerTensor,
    TensorRewrite.Pilot.Reduction.Plan.inputRank,
    TensorRewrite.Pilot.Reduction.Plan.outputRank,
    TensorRewrite.Pilot.Reduction.Plan.inputShape,
    TensorRewrite.Pilot.Reduction.Plan.outputShape,
    TensorRewrite.Pilot.Reduction.Plan.fiberCount,
    TensorRewrite.Pilot.Reduction.Plan.UnitReducedAxes,
    TensorRewrite.Pilot.Reduction.Plan.unitIndex,
    TensorRewrite.Pilot.Reduction.fiberValues,
    TensorRewrite.Pilot.Reduction.reduceTensor,
    TensorRewrite.Theory.Convolution.dilatedExtent,
    TensorRewrite.Theory.Convolution.Axis.outputExtent,
    TensorRewrite.Theory.Convolution.Axis.basePosition,
    TensorRewrite.Theory.Convolution.Axis.inputIndex?,
    TensorRewrite.Theory.Convolution.Plan.inputShape,
    TensorRewrite.Theory.Convolution.Plan.kernelShape,
    TensorRewrite.Theory.Convolution.Plan.outputShape,
    TensorRewrite.Theory.Convolution.spatialInput?,
    TensorRewrite.Theory.Convolution.term,
    TensorRewrite.Theory.Convolution.convolve,
    TensorRewrite.Theory.ConvolutionPointwise.IsPointwise,
    TensorRewrite.Theory.ConvolutionPointwise.kernelIndex,
    TensorRewrite.Theory.ConvolutionPointwise.inputIndex,
    TensorRewrite.Theory.ConvolutionPointwise.channelSum,
    TensorRewrite.Theory.LogicalFamily.Domain.zero,
