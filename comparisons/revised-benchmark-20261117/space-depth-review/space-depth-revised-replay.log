COMPILE ActualMergedGoal 0.345 0
@[expose] def Heldout.ActualMergedGoal.Goal : Prop :=
∀ {rank outerRank : Nat} {shape : Shape rank} {inner : Shape (rank + 1)} {outer : Shape outerRank} {α : Type}
  (plan : Conditions shape inner outer) (input : Tensor shape α) (out : Index outer),
  let m := ↑plan.axes.moved;
  let k := rank - m - 1;
  have leftRank := ⋯;
  have rightRank := ⋯;
  let leftShape := fun i => tailShape (cutShape plan.axes inner) (Fin.cast leftRank i);
  let rightShape := fun i => tailShape (replacementCutShape plan input) (Fin.cast rightRank i);
  have leftIndex := fun i => tailIndex (cutIndex plan.axes inner (originalOuterIndex plan out)) (Fin.cast leftRank i);
  have rightIndex := fun i => tailIndex (replacementCutIndex plan input out) (Fin.cast rightRank i);
  ↑(preIndex rightIndex 0) = ↑(preIndex leftIndex 0) * preShape leftShape 1 + ↑(preIndex leftIndex 1)

