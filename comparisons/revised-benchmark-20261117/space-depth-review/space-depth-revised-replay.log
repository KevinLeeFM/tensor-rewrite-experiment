COMPILE ActualSplitFactorGoal 0.279 0
@[expose] def Heldout.ActualSplitFactorGoal.Goal : Prop :=
∀ {rank outerRank : Nat} {shape : Shape rank} {inner : Shape (rank + 1)} {outer : Shape outerRank} {α : Type}
  (plan : Conditions shape inner outer) (input : Tensor shape α) (out : Index outer),
  let source := splitFrame shape plan.axes.split;
  let axis := concatAxis plan.axes;
  let framed := framedInput shape plan.axes.split ⋯ input;
  let frame := concatFrame shape plan.axes plan.width;
  have position := frame.position (replacementOuterIndex plan input out);
  have q := Fin.cast ⋯ position;
  ↑(originalIndex plan out plan.axes.split) =
    ↑(row q) * plan.width + ↑(replacementOuterIndex plan input out plan.axes.split)

