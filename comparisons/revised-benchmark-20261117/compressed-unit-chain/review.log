fun {n} {s t} =>
  step_verified : ∀ {n : Nat} {s t : Frame n} (op : Step n s t) (y : Digits t) (i : Fin n),
  pull op y (slot s (eff op i)) = y (slot t i)
fun {n} =>
  edit_verified : ∀ {n : Nat} (s t : Frame n) (w : Fin n → Nat) (y : Digits t),
  validUnit t y → ordinal (pairs s w (pull (Step.edit s t) y)) 0 = ordinal (pairs t w y) 0
fun {n} {s} =>
  chain_verified : ∀ {n : Nat} {s : Frame n} (c : Chain n s s),
  (∀ (i : Fin n), total c i = i) →
    ∀ (y : Digits s), validUnit s y → ∀ (α : Type) (data : Digits s → α), data (back c y) = data y
fun {n} {s t} =>
  raw_verified : ∀ {n : Nat} {s t : Frame n} (c : Chain n s t),
  (∀ (i : Fin n), total c i = i) →
    ∀ (su tu : Fin (n + 1)) (order : AxisPermutation n) (w : Fin n → Nat) (y : Digits t),
      validUnit t y →
        ∀ (α : Type) (storage : Nat → α), storage (address s su order w (back c y)) = storage (address t tu order w y)
fun {n} {s t} =>
  guard_verified : ∀ {n : Nat} {s t : Frame n} (c : Chain n s t),
  (∀ (i : Fin n), total c i = i) →
    ∀ (a : Digits s → Nat) (b : Digits t → Nat),
      SameAddress a b →
        ∀ (y : Digits t), validUnit t y → ∀ (α : Type) (storage : Nat → α), storage (a (back c y)) = storage (b y)
fun {n} {s t} =>
  bounded_verified : ∀ {n : Nat} {s t : Frame n} (c : Chain n s t),
  (∀ (i : Fin n), total c i = i) →
    ∀ (w : Fin n → Nat) (a : Digits s → Nat) (b : Digits t → Nat),
      (∀ (y : Digits t), validUnit t y → (∀ (i : Fin n), y (slot t i) < w i) → a (expand s (y ∘ slot t)) = b y) →
        ∀ (y : Digits t),
          validUnit t y →
            (∀ (i : Fin n), y (slot t i) < w i) →
              ∀ (α : Type) (storage : Nat → α), storage (a (back c y)) = storage (b y)
