  (plan : TensorRewrite.Theory.Convolution.Plan rank)
  (pointwise : TensorRewrite.Theory.ConvolutionPointwise.IsPointwise plan)
  (input : TensorRewrite.Theory.Convolution.Input plan α) (kernel : TensorRewrite.Theory.Convolution.Kernel plan α)
  (output : TensorRewrite.Theory.Convolution.OutputIndex plan),
  TensorRewrite.Theory.Convolution.convolve plan input kernel output =
    TensorRewrite.Pilot.Contraction.dotTensor (TensorRewrite.Theory.ConvolutionDot.matrixPlan plan)
      (fun x1 x2 => x1 + x2) 0 (fun x1 x2 => x1 * x2) id
      (TensorRewrite.Theory.ConvolutionDot.lhsMatrix plan input output.batchGroup output.featureGroup)
      (TensorRewrite.Theory.ConvolutionDot.rhsMatrix plan ⋯ kernel output.batchGroup output.featureGroup)
      (TensorRewrite.Theory.ConvolutionDot.dotOutput plan ⋯ output)
