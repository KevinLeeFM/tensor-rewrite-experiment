  (input : TensorRewrite.Theory.Convolution.Input plan α) (kernel : TensorRewrite.Theory.Convolution.Kernel plan α)
  (batchGroup : Fin plan.batchGroups) (featureGroup : Fin plan.featureGroups)
  (output : TensorRewrite.Pilot.Index (TensorRewrite.Theory.ConvolutionDot.matrixPlan plan).outputShape),
  TensorRewrite.Pilot.Contraction.dotTensor (TensorRewrite.Theory.ConvolutionDot.matrixPlan plan) (fun x1 x2 => x1 + x2)
      0 (fun x1 x2 => x1 * x2) id (TensorRewrite.Theory.ConvolutionDot.lhsMatrix plan input batchGroup featureGroup)
      (TensorRewrite.Theory.ConvolutionDot.rhsMatrix plan unitKernel kernel batchGroup featureGroup) output =
    ∑ channel,
      input (TensorRewrite.Pilot.FiniteProduct.join batchGroup (TensorRewrite.Pilot.FiniteProduct.row (output 0)))
          (TensorRewrite.Pilot.FiniteProduct.join featureGroup channel)
          (TensorRewrite.Pilot.LinearIndex.delinearize plan.inputShape
            (TensorRewrite.Pilot.FiniteProduct.column (output 0))) *
        kernel batchGroup featureGroup (output 1) channel
          (TensorRewrite.Theory.ConvolutionPointwise.kernelIndex plan unitKernel)
